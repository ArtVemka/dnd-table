{
  "name": "dnd-table",
  "version": "0.12.1-b",
  "private": true,
  "description": "Portable desktop application for D&D 5e",
  "author": {
    "name": "D&D Table"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/copy-vendor.js",
    "dist": "electron-builder --dir",
    "dist:portable": "electron-builder --dir && node scripts/make-portable.js",
    "test": "node test/integration.js && node test/importer.js && node test/sheet.js",
    "test:importer": "node test/importer.js",
    "foundry:fetch": "node scripts/fetch-foundry-sample.js",
    "foundry:demo": "node scripts/make-foundry-demo.js",
    "dnd-index": "node scripts/build-dnd-index.js",
    "test:sheet": "node test/sheet.js"
  },
  "dependencies": {
    "@number0/iroh": "^1.1.0",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "ru.dndstol.app",
    "productName": "D&D Стол",
    "directories": {
      "output": "dist-final",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-sheet.js",
      "package.json",
      "server/**/*",
      "renderer/**/*",
      "scripts/copy-vendor.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "D&D 5e (2014) portable table top",
      "executableName": "DND-Table",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
