{
  "name": "dnd-table",
  "version": "1.10.3",
  "private": true,
  "description": "Portable desktop application for D&D 5e",
  "author": {
    "name": "D&D Table"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/copy-vendor.js",
    "dist": "electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "dist:portable": "electron-builder --dir --config.electronDist=node_modules/electron/dist && node scripts/make-portable.js",
    "dist:setup": "node scripts/build-setup.js",
    "test": "node test/styles.js && node test/integration.js && node test/importer.js && node test/sheet.js && node test/iroh-identity.js && node test/android-bridge.js && node test/open5e.js && node test/presence.js",
    "test:android-bridge": "node test/android-bridge.js",
    "test:importer": "node test/importer.js",
    "test:presence": "node test/presence.js",
    "foundry:fetch": "node scripts/fetch-foundry-sample.js",
    "foundry:demo": "node scripts/make-foundry-demo.js",
    "dnd-index": "node scripts/build-dnd-index.js",
    "test:sheet": "node test/sheet.js"
  },
  "dependencies": {
    "@number0/iroh": "^1.1.0",
    "electron-updater": "^6.8.11",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "ru.dndstol.app",
    "productName": "D&D Стол",
    "directories": {
      "output": "dist-final",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "ArtVemka",
      "repo": "dnd-table"
    },
    "files": [
      "main.js",
      "discord-presence.js",
      "preload.js",
      "preload-sheet.js",
      "preload-journal.js",
      "package.json",
      "build/icon.png",
      "server/**/*",
      "renderer/**/*",
      "scripts/copy-vendor.js",
      "scripts/version-label.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "DND-Table-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "D&D Стол"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "D&D 5e (2014) portable table top",
      "executableName": "DND-Table",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
