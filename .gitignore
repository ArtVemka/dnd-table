node_modules/
data/
.opencode/
*.log
test-output.txt
verify.log

# Результаты сборки и папка для отправки.
# dist-*/ закрывает и dist-final, и обходные сборки dist-fresh: их приходится
# делать, когда занята предыдущая папка.
dist/
dist-*/
release/

# Портативный режим: маркер и папка данных не коммитятся
portable.txt

# Резервная копия кампаний — тоже не коммитится, она только на этом диске
data-backup/

# Снимки экранов, которые делает scripts/make-shots.js: они нужны
# для оценки оформления, но в репозитории им не место
shots/

# Чужие выгрузки Foundry для проверки импорта: их качает
# scripts/fetch-foundry-sample.js, в репозитории им не место
test/fixtures/foundry/*.json
test/fixtures/foundry/*.zip
